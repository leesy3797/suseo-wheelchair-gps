NAVER_MAP_CLIENT_ID=your_naver_maps_client_id
ANCHOR_LAT=37.485000
ANCHOR_LON=127.103000
MODEL_SCALE=1
# Fixed coordinate transform established during field calibration.
# Once set, the manager dashboard opens with this mapping and no calibration UI.
STATION_ORIGIN_LAT=37.485000
STATION_ORIGIN_LON=127.103000
STATION_ORIGIN_X=0
STATION_ORIGIN_Z=0
STATION_ROTATION_DEG=0
STATION_METERS_TO_MODEL=1
# Development allows every Socket.IO browser origin. In AWS, replace both values
# with your HTTPS domain, for example https://gps.example.com.
SOCKET_CORS_ALLOWED_ORIGINS=*
TRUSTED_HOSTS=*
# AWS example: keep SQLite outside the deployed source directory.
# SUSEO_DB_PATH=/opt/suseo-wheelchair-gps/data/monitoring.sqlite3

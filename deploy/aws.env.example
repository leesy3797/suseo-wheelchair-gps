# Copy to /opt/suseo-wheelchair-gps/.env and replace the example values.
NAVER_MAP_CLIENT_ID=your_naver_maps_client_id
ANCHOR_LAT=37.485000
ANCHOR_LON=127.103000
MODEL_SCALE=1
STATION_ORIGIN_LAT=37.485000
STATION_ORIGIN_LON=127.103000
STATION_ORIGIN_X=0
STATION_ORIGIN_Z=0
STATION_ROTATION_DEG=0
STATION_METERS_TO_MODEL=1
SUSEO_DB_PATH=/opt/suseo-wheelchair-gps/data/monitoring.sqlite3
SOCKET_CORS_ALLOWED_ORIGINS=http://suseo-wheelchair-gps.duckdns.org,https://suseo-wheelchair-gps.duckdns.org
TRUSTED_HOSTS=suseo-wheelchair-gps.duckdns.org,localhost,127.0.0.1

[Unit]
Description=Suseo wheelchair GPS monitoring server
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/suseo-wheelchair-gps
EnvironmentFile=/opt/suseo-wheelchair-gps/.env
ExecStart=/opt/suseo-wheelchair-gps/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
